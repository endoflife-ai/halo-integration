{
  "_comment": "Title -> endoflife.ai product rules for Halo asset OS fields and software rows. First match wins; specific before generic. version: 'group' takes the named capture group <v> from the title, 'field' takes the software row's own version string, 'year' maps a product year through 'years', 'windows-client' builds 10-22h2-w style cycles, 'major' keeps the first number group, 'major.minor' the first two. Anything that matches no rule is tried once by slugified name through /v1/sbom?enrich=1 and reported as not tracked when unknown. Edit freely; the tests in test/map.test.mjs pin the demo and enterprise titles.",
  "rules": [
    { "pattern": "windows server[, ]*(?<v>20\\d\\d)(?:\\s*r2)?", "slug": "windows-server", "version": "group", "type": "operating-system", "postfix": { "r2": "-r2" } },
    { "pattern": "windows server", "slug": "windows-server", "version": "field", "type": "operating-system" },
    { "pattern": "windows (?:10|11)|windows\\s*$|microsoft windows", "slug": "windows", "version": "windows-client", "type": "operating-system" },
    { "pattern": "windows (?<v>8\\.1|8|7)\\b", "slug": "windows", "version": "group", "type": "operating-system" },
    { "pattern": "sql server", "slug": "mssqlserver", "version": "year", "type": "application", "years": { "2008 r2": "10.50", "2008": "10.00", "2012": "11.0", "2014": "12.0", "2016": "13.0", "2017": "14.0", "2019": "15.0", "2022": "16.0", "2025": "17.0" } },
    { "pattern": "exchange server", "slug": "msexchange", "version": "year", "type": "application", "years": { "2010": "2010", "2013": "2013", "2016": "2016", "2019": "2019", "subscription": "se" } },
    { "pattern": "sharepoint", "slug": "sharepoint", "version": "year", "type": "application", "years": { "2010": "2010", "2013": "2013", "2016": "2016", "2019": "2019", "subscription": "subscription" } },
    { "pattern": "\\boffice\\b|microsoft 365 apps", "slug": "office", "version": "year", "type": "application", "years": { "2010": "2010", "2013": "2013", "2016": "2016", "2019": "2019", "2021": "2021", "2024": "2024" } },
    { "pattern": "\\.net framework", "slug": "dotnetfx", "version": "major.minor.patch", "prefer": "title", "type": "application" },
    { "pattern": "\\.net (?:core|runtime|sdk|desktop)|\\bdotnet\\b|windows desktop runtime", "slug": "dotnet", "version": "major", "type": "application" },
    { "pattern": "red hat enterprise linux|\\brhel\\b", "slug": "rhel", "version": "major", "type": "operating-system" },
    { "pattern": "ubuntu", "slug": "ubuntu", "version": "major.minor", "type": "operating-system" },
    { "pattern": "debian", "slug": "debian", "version": "major", "type": "operating-system" },
    { "pattern": "almalinux", "slug": "almalinux", "version": "major", "type": "operating-system" },
    { "pattern": "rocky linux", "slug": "rocky-linux", "version": "major", "type": "operating-system" },
    { "pattern": "centos", "slug": "centos", "version": "major", "type": "operating-system" },
    { "pattern": "\\bsles\\b|suse linux enterprise", "slug": "sles", "version": "major", "type": "operating-system" },
    { "pattern": "\\bmac ?os\\b|\\bos x\\b", "slug": "macos", "version": "major", "type": "operating-system" },
    { "pattern": "esxi", "slug": "vmware-esxi", "version": "major.minor", "type": "operating-system" },
    { "pattern": "vcenter", "slug": "vmware-vcenter", "version": "major.minor", "type": "application" },
    { "pattern": "fortios|fortigate", "slug": "fortios", "version": "major.minor", "type": "firmware" },
    { "pattern": "pan-?os|palo alto", "slug": "panos", "version": "major.minor", "type": "firmware" },
    { "pattern": "ios[- ]xe", "slug": "cisco-ios-xe", "version": "major.minor", "type": "firmware" },
    { "pattern": "internet information services|\\biis\\b", "slug": "iis", "version": "major", "type": "application" },
    { "pattern": "oracle (?:jdk|java)", "slug": "oracle-jdk", "version": "major", "type": "application" },
    { "pattern": "temurin|adoptium", "slug": "eclipse-temurin", "version": "major", "type": "application" },
    { "pattern": "openjdk|\\bjava\\b", "slug": "openjdk", "version": "major", "type": "application" },
    { "pattern": "postgresql|postgres", "slug": "postgresql", "version": "major", "type": "application" },
    { "pattern": "mysql", "slug": "mysql", "version": "major.minor", "type": "application" },
    { "pattern": "mariadb", "slug": "mariadb", "version": "major.minor", "type": "application" },
    { "pattern": "node\\.?js", "slug": "nodejs", "version": "major", "type": "application" },
    { "pattern": "\\bpython\\b", "slug": "python", "version": "major.minor", "type": "application" },
    { "pattern": "\\bphp\\b", "slug": "php", "version": "major.minor", "type": "application" },
    { "pattern": "tomcat", "slug": "tomcat", "version": "major", "type": "application" },
    { "pattern": "apache http|httpd", "slug": "apache", "version": "major.minor", "type": "application" },
    { "pattern": "nginx", "slug": "nginx", "version": "major.minor", "type": "application" },
    { "pattern": "google chrome|\\bchrome\\b", "slug": "chrome", "version": "major", "type": "application" },
    { "pattern": "firefox", "slug": "firefox", "version": "major", "type": "application" },
    { "pattern": "microsoft edge|webview2", "slug": "microsoft-edge", "version": "major", "type": "application" },
    { "pattern": "visual studio code", "slug": "vscode", "version": "major.minor", "type": "application" },
    { "pattern": "visual studio(?! code| tools)", "slug": "visual-studio", "version": "year", "type": "application", "years": { "2017": "2017", "2019": "2019", "2022": "2022" } },
    { "pattern": "powershell", "slug": "powershell", "version": "major.minor", "type": "application" },
    { "pattern": "globalprotect", "slug": "pangp", "version": "major.minor", "type": "application" },
    { "pattern": "\\bzoom\\b", "slug": "zoom", "version": "major.minor", "type": "application" },
    { "pattern": "\\bteams\\b", "slug": "msteams", "version": "field", "type": "application" }
  ]
}
